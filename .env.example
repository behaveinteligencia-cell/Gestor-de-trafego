# Copie para .env.local. Nunca versione tokens.
# GESTOR_MODO=demo liga o adaptador de demonstração (dados sintéticos) para todas as contas.
GESTOR_MODO=
GESTOR_DB_PATH=
# Quem assina as ações do Claude no log (opcional)
GESTOR_AUTOR=claude

# Meta Ads (Marketing API) — token de sistema com ads_read / ads_management
META_ACCESS_TOKEN=
META_API_VERSION=v24.0

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# TikTok Ads (Marketing API)
TIKTOK_ACCESS_TOKEN=

# LinkedIn Marketing API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=202510
